NEXT_PUBLIC_SUPABASE_URL=
# Supabase now shows this as a publishable key. Either variable works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Browser-restricted key with Maps JavaScript API + Directions API enabled.
# Supported aliases: NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY, NEXT_PUBLIC_GOOGLE_API_KEY, NEXT_PUBLIC_MAPS_API_KEY.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server-restricted key with Geocoding API enabled.
# Supported aliases: GOOGLE_MAPS_GEOCODING_API_KEY, GOOGLE_MAPS_API_KEY, GOOGLE_API_KEY.
GOOGLE_MAPS_SERVER_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
